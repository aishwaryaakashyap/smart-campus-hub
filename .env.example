DATABASE_URL=mysql+pymysql://campus_app:YOUR_PASSWORD_HERE@localhost/smart_campus_hub
SECRET_KEY=your-secret-key-here

# Set to 1 in production when serving the app over HTTPS.
SESSION_COOKIE_SECURE=0

# Email settings (example: Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Local development URL. Change to your HTTPS domain in production.
APP_BASE_URL=http://127.0.0.1:5000
